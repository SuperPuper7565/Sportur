@model IEnumerable<Sportur.Models.Order>

<h2>Заказы</h2>

<div class="mb-3">
    <a asp-action="ExportCsv" class="btn btn-success">Экспорт в CSV</a>
    <a asp-action="ExportJson" class="btn btn-outline-success">Экспорт в JSON</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Дата</th>
            <th>Пользователь</th>
            <th>Количество позиций</th>
            <th>Сумма</th>
            <th>Статус</th>
            <th>Управление</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@(order.User?.Email ?? "Guest")</td>
                <td>@order.Items.Count</td>
                <td>@order.TotalPrice ₽</td>
                <td>
                    <span class="admin-order-status">@order.Status</span>
                </td>
                <td>
                    <div class="admin-order-actions">
                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-primary btn-sm admin-order-actions__details">
                            Подробнее
                        </a>

                        <form asp-action="UpdateStatus" method="post" class="admin-order-status-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@order.Id" />
                            <select id="status-@order.Id" name="status" class="form-select form-select-sm">
                                <option selected="@(order.Status == "Новый" ? "selected" : null)" value="Новый">Новый</option>
                                <option selected="@(order.Status == "В обработке" ? "selected" : null)" value="В обработке">В обработке</option>
                                <option selected="@(order.Status == "Отправлен" ? "selected" : null)" value="Отправлен">Отправлен</option>
                                <option selected="@(order.Status == "Выполнен" ? "selected" : null)" value="Выполнен">Выполнен</option>
                                <option selected="@(order.Status == "Отменён" ? "selected" : null)" value="Отменён">Отменён</option>
                            </select>
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Сохранить</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
@model List<Sportur.ViewModels.OrderViewModel>
@{
    ViewData["Title"] = "Мои заказы";
}

@section Styles {
    <link rel="stylesheet" href="~/css/my-orders.css" asp-append-version="true" />
}

<div class="orders-page">
    <div class="orders-header">
        <div>
            <h1 class="orders-title">Мои заказы</h1>
            <p class="orders-subtitle">История ваших покупок и детальная информация по каждому заказу.</p>
        </div>
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-primary orders-back-btn">
            ← Назад к каталогу
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="orders-empty-state">
            <h2>Пока заказов нет</h2>
            <p>Вы ещё не оформили ни одного заказа. Выберите велосипед в каталоге и оформите покупку.</p>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary">Перейти в каталог</a>
        </div>
    }
    else
    {
        <div class="orders-list">
            @foreach (var order in Model)
            {
                <section class="order-card">
                    <div class="order-card-header">
                        <strong>Заказ №@order.OrderId</strong>
                        <span>@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle order-table">
                            <thead>
                                <tr>
                                    <th>Модель</th>
                                    <th>Цвет</th>
                                    <th>Размер</th>
                                    <th>Цена</th>
                                    <th>Кол-во</th>
                                    <th>Сумма</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in order.Items)
                                {
                                    <tr>
                                        <td>@item.ModelName</td>
                                        <td>@item.Color</td>
                                        <td>@item.FrameSize</td>
                                        <td>@item.Price.ToString("N2") ₽</td>
                                        <td>@item.Quantity</td>
                                        <td class="order-item-total">@item.Total.ToString("N2") ₽</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="order-total">
                        Итого: @order.TotalPrice.ToString("N2") ₽
                    </div>
                </section>
            }
        </div>
    }
</div>